# Azure OpenAI (필수) - Azure Portal에서 Azure OpenAI 리소스 생성 후 발급
# 예: AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
# 예: AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini (Azure AI Studio에서 만든 배포 이름)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# 상품 데이터는 다나와(Danawa) 검색 결과 페이지를 실시간 스크래핑해서 가져옵니다. 별도 API 키 불필요.

# 서버 포트
PORT=3000
